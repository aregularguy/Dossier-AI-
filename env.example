# Copy this file to .env.local and fill in real values.
# Next.js loads .env.local — restart `npm run dev` after changing it.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Groq (resume analysis) - https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# Optional: override the chat model (see https://console.groq.com/docs/models)
# GROQ_MODEL=openai/gpt-oss-120b

# Optional: RAG / "Ask my documents" backend
NEXT_PUBLIC_RAG_API_URL=http://localhost:8000
